                                "example": {
                                    "user": {
                                        "_id": "507f1f77bcf86cd799439011",
                                        "username": "johndoe",
                                        "displayName": "John Doe"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Update user",
                "tags": [
                    "User"
                ],
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "username": {
                                        "type": "string"
                                    },
                                    "displayName": {
                                        "type": "string"
                                    },
                                    "bio": {
                                        "type": "string"
                                    },
                                    "phone": {
                                        "type": "string"
                                    },
                                    "location": {
                                        "type": "string"
                                    },
                                    "birthDay": {
                                        "type": "string"
                                    },
                                    "linkSocialOther": {
                                        "type": "object"
                                    }
                                }
                            },
