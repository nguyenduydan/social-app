{
    "openapi": "3.0.0",
    "info": {
        "title": "DiFa Social API",
        "version": "1.0.0",
        "description": "API documentation for the social media backend (authentication, posts, users, messages, conversations, and friends)."
    },
    "servers": [
        {
            "url": "http://localhost:3000/api",
            "description": "Local development server"
        }
    ],
    "paths": {
        "/auth/signin": {
            "post": {
                "summary": "Sign in user",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                }
                            },
                            "example": {
                                "email": "admin@gmail.com",
                                "password": "danvip123"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "example": {
                                    "user": {
                                        "_id": "507f1f77bcf86cd799439011",
                                        "email": "user@example.com",
                                        "firstName": "John",
                                        "lastName": "Doe",
                                        "username": "johndoe",
                                        "displayName": "John Doe",
                                        "avatar": "https://example.com/avatar.jpg",
                                        "coverPhoto": null,
                                        "bio": "Hello, I'm John!",
                                        "createdAt": "2025-01-15T10:30:00Z"
                                    },
                                    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/signup": {
            "post": {
                "summary": "Register new user",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "firstName": {
                                        "type": "string"
                                    },
                                    "lastName": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                }
                            },
                            "example": {
                                "firstName": "Jane",
                                "lastName": "Smith",
                                "email": "jane.smith@example.com",
                                "password": "SecurePass123!"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "User registered successfully"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "summary": "Logout current user",
                "tags": [
                    "Auth"
                ],
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Logout successful"
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "summary": "Refresh access token",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "Token refreshed",
                        "content": {
                            "application/json": {
                                "example": {
                                    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/forgot-password": {
            "post": {
                "summary": "Send reset code to email",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                }
                            },
                            "example": {
                                "email": "user@example.com"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reset code sent",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Mã xác nhận đã được gửi tới email",
                                    "email": "user@example.com"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/verify-reset-code": {
            "post": {
                "summary": "Verify reset code",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "code"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "code": {
                                        "type": "string"
                                    }
                                }
                            },
                            "example": {
                                "email": "user@example.com",
                                "code": "123456"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Code verified",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Mã hợp lệ"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/reset-password": {
            "patch": {
                "summary": "Reset password",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "newPassword"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "newPassword": {
                                        "type": "string"
                                    }
                                }
                            },
                            "example": {
                                "email": "user@example.com",
                                "newPassword": "NewPass123!"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset successfully"
                    }
                }
            }
        },
        "/auth/google": {
            "get": {
                "summary": "Google OAuth login",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to Google"
                    }
                }
            }
        },
        "/auth/oauth/callback": {
            "get": {
                "summary": "Google OAuth callback",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to client"
                    }
                }
            }
        },
