                                "type": "object",
                                "properties": {
                                    "buffer": {
                                        "type": "string"
                                    },
                                    "mimetype": {
                                        "type": "string"
                                    },
                                    "originalname": {
                                        "type": "string"
                                    }
                                }
                            },
                            "example": {
                                "buffer": "base64_encoded_data",
                                "mimetype": "image/jpeg",
                                "originalname": "avatar.jpg"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Avatar uploaded"
